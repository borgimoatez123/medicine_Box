# Similarity threshold: verified = similarity >= FACE_SIMILARITY_THRESHOLD
# The existing project tests used approximately 0.30.
FACE_SIMILARITY_THRESHOLD=0.30

# Bind host: allow the Raspberry Pi on the LAN to reach this service.
HOST=0.0.0.0
PORT=8000

# Max image upload size per file (bytes). Default 8 MiB is enough for any 2 MP JPEG.
FACE_MAX_IMAGE_BYTES=8388608
